NASM = nasm
GCC = gcc
GXX = g++
ifeq ($(COMPILER),gcc)
  CC   = gcc
  CC++ = g++
else
  CC   = clang
  CC++ = clang++
endif

C_STD    = -std=c11
CPP_STD = -std=c++20

INCLUDES = -Iinclude -Ikernel/programs/doomgeneric -Ithird_party/bearssl/inc \
  -Ithird_party/bearssl/src

RED_ZONE_FLAG ?= -mred-zone

COMMON_FLAGS = -march=x86-64-v3 -ffast-math \
  -ffreestanding -Wall -Wextra -w $(RED_ZONE_FLAG) -m64 \
  -fno-exceptions -fno-stack-protector -fno-rtti \
  -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-ident -fvisibility=hidden\
  -flto=full -ffunction-sections -fdata-sections -fmerge-all-constants $(INCLUDES)

ifeq ($(COMPILER),gcc)
	LESS_EXTR_FLAGS = \
		-ftree-loop-vectorize \
		-ftree-vectorize \
		-fallow-store-data-races \
		-fno-semantic-interposition
  LTO_LINK_FLAG    = -flto=auto
else
  LESS_EXTR_FLAGS = -mllvm -enable-gvn-hoist=true \
    -mllvm -enable-gvn-sink=true \
    -mllvm -enable-interleaved-mem-accesses=true
  LTO_LINK_FLAG    = -flto=full -fuse-ld=lld
endif

CFLAGS_C        = $(COMMON_FLAGS) -O2 $(LESS_EXTR_FLAGS) $(C_STD)
CFLAGS_CPP      = $(COMMON_FLAGS) -O2 $(LESS_EXTR_FLAGS) $(CPP_STD)
CFLAGS_C_PERF   = $(COMMON_FLAGS) -O3 $(LESS_EXTR_FLAGS) $(C_STD)
CFLAGS_CPP_PERF = $(COMMON_FLAGS) -O3 $(LESS_EXTR_FLAGS) $(CPP_STD)
CFLAGS_C_SIZE   = $(COMMON_FLAGS) -O1 $(LESS_EXTR_FLAGS) $(C_STD)
CFLAGS_CPP_SIZE = $(COMMON_FLAGS) -O1 $(LESS_EXTR_FLAGS) $(CPP_STD)
CFLAGS_BEARSSL  = $(COMMON_FLAGS) -O2 $(LESS_EXTR_FLAGS) $(C_STD) \
  -DBR_USE_URANDOM=0 -DBR_USE_UNIX_TIME=0 -DBR_USE_WIN32_RAND=0 -DBR_RDRAND=0

LDFLAGS = -static -ffreestanding -nostdlib -flto=full -fuse-ld=lld \
  -Wl,-O3 -Wl,-n -Wl \
  -Wl,--gc-sections -Wl,--icf=all \
  -Wl,--strip-all -Wl,--build-id=none \
	-Wl,-z,max-page-size=0x1000 \
  -Wl,-T,arch/linker.ld

# The comparison run favored GCC for the heap, mouse, PCI, and VFS paths.
# Keep Clang as the whole-program/LTO compiler (it led keyboard, scheduler,
# workflow, and especially math), while compiling those GCC-favored modules
# as native objects. lld links these ELF objects alongside Clang ThinLTO.
GCC_TUNED_SRCS = kernel/memory/heap.cpp kernel/drivers/mouse.cpp \
  kernel/drivers/pci.cpp kernel/fs/laziofs.cpp
GCC_TUNED_OBJS = $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(GCC_TUNED_SRCS))
GCC_TUNED_FLAGS = -march=x86-64-v3 -ffast-math -ffreestanding -Wall -Wextra -w \
  -mred-zone -m64 -fno-exceptions -fno-stack-protector -fno-rtti \
  -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-ident \
  -fvisibility=hidden -ffunction-sections -fdata-sections \
  -fmerge-all-constants -fno-lto $(INCLUDES) -O3 \
  -ftree-loop-vectorize -ftree-vectorize -fallow-store-data-races $(CPP_STD)

ASM_SRCS = $(shell find arch kernel -name '*.asm' $(EXCLUDE))
GAS_SRCS = $(shell find arch kernel -name '*.S' $(EXCLUDE))
C_SRCS   = $(shell find arch kernel -name '*.c' $(EXCLUDE))
C++_SRCS = $(shell find arch kernel -name '*.cpp' $(EXCLUDE))

BUILD_DIR = build
OS_ISO ?= os.iso
DISK_IMAGE ?= disk.img
RUST_TARGET = x86_64-unknown-none
RUST_TARGET_DIR = $(BUILD_DIR)/rust
RUST_NET_LIB = $(RUST_TARGET_DIR)/$(RUST_TARGET)/release/libosfos_net.a
RUST_NET_SOURCES = $(shell find rust/net/src -type f -name '*.rs')

BEARSSL_SOURCES = $(shell find third_party/bearssl/src -type f -name '*.c')
BEARSSL_OBJS = $(patsubst %.c,$(BUILD_DIR)/%.o,$(BEARSSL_SOURCES))

KERNEL_LIB_C_OBJS       = $(patsubst %.c,$(BUILD_DIR)/%.o,$(shell find kernel/lib -name '*.c' 2>/dev/null))
KERNEL_LIB_CPP_OBJS     = $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(shell find kernel/lib -name '*.cpp' 2>/dev/null))
KERNEL_NET_C_OBJS       = $(patsubst %.c,$(BUILD_DIR)/%.o,$(shell find kernel/net -name '*.c' 2>/dev/null))
KERNEL_NET_CPP_OBJS     = $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(shell find kernel/net -name '*.cpp' 2>/dev/null))
KERNEL_MEMORY_C_OBJS    = $(patsubst %.c,$(BUILD_DIR)/%.o,$(shell find kernel/memory -name '*.c' 2>/dev/null))
KERNEL_MEMORY_CPP_OBJS  = $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(shell find kernel/memory -name '*.cpp' 2>/dev/null))
KERNEL_FS_C_OBJS        = $(patsubst %.c,$(BUILD_DIR)/%.o,$(shell find kernel/fs -name '*.c' 2>/dev/null))
KERNEL_FS_CPP_OBJS      = $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(shell find kernel/fs -name '*.cpp' 2>/dev/null))

KERNEL_O3_C_OBJS   = $(KERNEL_LIB_C_OBJS) $(KERNEL_NET_C_OBJS) $(KERNEL_MEMORY_C_OBJS) $(KERNEL_FS_C_OBJS)
KERNEL_O3_CPP_OBJS = $(KERNEL_LIB_CPP_OBJS) $(KERNEL_NET_CPP_OBJS) $(KERNEL_MEMORY_CPP_OBJS) $(KERNEL_FS_CPP_OBJS)

PROGRAM_C_OBJS   = $(patsubst %.c,$(BUILD_DIR)/%.o,$(shell find kernel/programs -name '*.c' 2>/dev/null))
PROGRAM_CPP_OBJS = $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(shell find kernel/programs -name '*.cpp' 2>/dev/null))

GRAPHICS_OBJS    = $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(wildcard kernel/graphics/*.cpp))
ARCH_PERF_C_OBJS = $(BUILD_DIR)/arch/x86_64/memory.o $(BUILD_DIR)/arch/x86_64/string.o

DRIVER_C_OBJS    = $(patsubst %.c,$(BUILD_DIR)/%.o,$(shell find kernel/drivers -name '*.c'))
DRIVER_CPP_OBJS  = $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(shell find kernel/drivers -name '*.cpp'))
DRIVER_OBJS      = $(DRIVER_C_OBJS) $(DRIVER_CPP_OBJS)

OBJS = $(sort \
  $(patsubst %.asm,$(BUILD_DIR)/%.o,$(ASM_SRCS)) \
  $(patsubst %.S,$(BUILD_DIR)/%.o,$(GAS_SRCS)) \
  $(patsubst %.c,$(BUILD_DIR)/%.o,$(C_SRCS)) \
  $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(C++_SRCS)) \
  $(BEARSSL_OBJS) \
  $(PROGRAM_CPP_OBJS) \
  $(PROGRAM_C_OBJS) \
  $(GRAPHICS_OBJS) \
  $(ARCH_PERF_C_OBJS) \
  $(KERNEL_O3_C_OBJS) \
  $(KERNEL_O3_CPP_OBJS) \
  $(DRIVER_C_OBJS) \
  $(DRIVER_CPP_OBJS) \
)

$(KERNEL_O3_C_OBJS):    CFLAGS_C   = $(CFLAGS_C_PERF)
$(KERNEL_O3_CPP_OBJS):  CFLAGS_CPP = $(CFLAGS_CPP_PERF)
$(GRAPHICS_OBJS):       CFLAGS_CPP = $(CFLAGS_CPP_PERF)
$(ARCH_PERF_C_OBJS):    CFLAGS_C   = $(CFLAGS_C_PERF)
$(BEARSSL_OBJS):        CFLAGS_C   = $(CFLAGS_BEARSSL)
$(DRIVER_C_OBJS):       CFLAGS_C   = $(CFLAGS_C_PERF)
$(DRIVER_CPP_OBJS):     CFLAGS_CPP = $(CFLAGS_CPP_PERF)

opt_flag = $(lastword $(filter -O%,$(1)))
opt_tag  = $(patsubst -%,%,$(call opt_flag,$(1)))

TAG_C   = [CC  $(call opt_tag,$(CFLAGS_C))]
TAG_CPP = [C++ $(call opt_tag,$(CFLAGS_CPP))]

ifeq ($(V),1)
  Q =
else
  Q = @
endif

TERM_COLS ?= $(shell tput cols 2>/dev/null || echo 80)
FILE_WIDTH = $(shell awk -v cols=$(TERM_COLS) 'BEGIN { w = cols - 23; if (w < 23) w = 23; print w }')

define PRINT_TUI
  @flock /tmp/make_tui.lock sh -c ' \
  SZ=$$(wc -c < $@ | tr -d " "); \
  if [ $$SZ -ge 1048576 ]; then \
    SZ_FMT=$$(awk "BEGIN {printf \"%.2f MB\", $$SZ / 1048576}"); \
  elif [ $$SZ -ge 1024 ]; then \
    SZ_FMT=$$(awk "BEGIN {printf \"%.2f KB\", $$SZ / 1024}"); \
  else \
    SZ_FMT="$${SZ} B"; \
  fi; \
  TAG_RAW="$(1)"; \
  TAG_LEN=$${#TAG_RAW}; \
  PAD_LEN=$$(( 9 - TAG_LEN )); \
  [ $$PAD_LEN -lt 0 ] && PAD_LEN=0; \
  PADDING=$$(printf "%*s" $$PAD_LEN ""); \
  FILE_WIDTH=$(FILE_WIDTH); \
  printf "\033[1;36m%s\033[0m%s\033[37m%-*s\033[0m   \033[1;32m%10s\033[0m\n" "$$TAG_RAW" "$$PADDING" "$$FILE_WIDTH" "$(2)" "$$SZ_FMT" \
  '
endef

.PHONY: all clean simd filesimd compare-redzone compare-compiler

all: $(OS_ISO) $(DISK_IMAGE)

RUNS ?= 3
JOBS ?= 6
BOOT_TIMEOUT ?= 25
QEMU ?= qemu-system-x86_64

compare-redzone:
	@python3 tools/compare-redzone.py --runs "$(RUNS)" --jobs "$(JOBS)" \
	  --boot-timeout "$(BOOT_TIMEOUT)" --qemu "$(QEMU)"

compare-compiler:
	@python3 tools/compare-compiler.py --runs "$(RUNS)" --jobs "$(JOBS)" \
	  --boot-timeout "$(BOOT_TIMEOUT)" --qemu "$(QEMU)"

DOOM1_WAD = $(firstword $(wildcard doom1.wad doom.wad))
DOOM2_WAD = $(wildcard doom2.wad)
DOOM_WADS = $(DOOM1_WAD) $(DOOM2_WAD)
ifneq ($(DOOM_WADS),)
$(DISK_IMAGE): $(DOOM_WADS) tools/mklaziofs.py
	@mkdir -p $(@D)
	@python3 tools/mklaziofs.py $@ $(if $(DOOM1_WAD),--add /bin/doom/doom1.wad=$(DOOM1_WAD)) $(if $(DOOM2_WAD),--add /bin/doom/doom2.wad=$(DOOM2_WAD))
else
$(DISK_IMAGE): tools/mklaziofs.py
	@mkdir -p $(@D)
	@python3 tools/mklaziofs.py $@
endif

$(BUILD_DIR)/%.o: %.asm Makefile
	@mkdir -p $(@D)
	@$(NASM) -Ox -f elf64 $< -o $@
ifeq ($(V),1)
else
	@$(call PRINT_TUI, [ASM   ], $<)
endif

$(BUILD_DIR)/%.o: %.S Makefile
	@mkdir -p $(@D)
	@$(CC) $(COMMON_FLAGS) -c -x assembler-with-cpp $< -o $@
ifeq ($(V),1)
else
	@$(call PRINT_TUI, [GAS   ], $<)
endif

$(BUILD_DIR)/%.o: %.c Makefile
	@mkdir -p $(@D)
ifeq ($(COMPILER),gcc)
	@$(CC) $(CFLAGS_C) -c $< -o $@
else
	@$(CC) $(CFLAGS_C) -emit-llvm -c $< -o $(@:.o=.bc)
	@$(CC) $(CFLAGS_C) -c $(@:.o=.bc) -o $@
	@rm -f $(@:.o=.bc)
endif
ifeq ($(V),1)
else
	@$(call PRINT_TUI, $(TAG_C), $<)
endif

$(BUILD_DIR)/%.o: %.cpp Makefile
	@mkdir -p $(@D)
ifeq ($(COMPILER),gcc)
	@$(CC++) $(CFLAGS_CPP) -c $< -o $@
else
	@if [ -n "$(filter $<,$(GCC_TUNED_SRCS))" ]; then \
	  $(GXX) $(GCC_TUNED_FLAGS) -c $< -o $@; \
	else \
	  $(CC++) $(CFLAGS_CPP) -emit-llvm -c $< -o $(@:.o=.bc) && \
	  $(CC++) $(CFLAGS_CPP) -c $(@:.o=.bc) -o $@ && \
	  rm -f $(@:.o=.bc); \
	fi
endif
ifeq ($(V),1)
else
	@$(call PRINT_TUI, $(TAG_CPP), $<)
endif

$(BUILD_DIR)/os.bin: $(OBJS) $(RUST_NET_LIB)
	$(Q)mkdir -p $(@D)
	$(Q)$(CC) $(LDFLAGS) $(OBJS) $(RUST_NET_LIB) -o $@
	$(Q)llvm-strip --strip-all --remove-section=.comment --remove-section=.note $@ 2>/dev/null || true
ifeq ($(V),1)
else
	$(Q)$(call PRINT_TUI, [LD    ], $@)
endif

$(RUST_NET_LIB): rust/net/Cargo.toml rust/net/Cargo.lock $(RUST_NET_SOURCES) Makefile
	$(Q)PATH="$(HOME)/.cargo/bin:$$PATH" CARGO_TARGET_DIR="$(abspath $(RUST_TARGET_DIR))" \
	RUSTFLAGS="$(RUSTFLAGS) -C target-cpu=x86-64-v3" \
	cargo build --locked --manifest-path rust/net/Cargo.toml \
		--target $(RUST_TARGET) --release $(if $(filter 1,$(V)),,--quiet)
	$(Q)test -f $@
ifeq ($(V),1)
else
	$(Q)$(call PRINT_TUI, [RUST  ], rust/net/src/lib.rs)
endif

$(OS_ISO): $(BUILD_DIR)/os.bin grub.cfg
	$(Q)mkdir -p $(BUILD_DIR)/iso/boot/grub
	$(Q)cp $(BUILD_DIR)/os.bin $(BUILD_DIR)/iso/boot/os.bin
	$(Q)cp grub.cfg $(BUILD_DIR)/iso/boot/grub/grub.cfg
	$(Q)grub-mkrescue -o $@ $(BUILD_DIR)/iso >/dev/null 2>&1
	$(Q)rm -rf $(BUILD_DIR)/iso
ifeq ($(V),1)
else
	$(Q)$(call PRINT_TUI, [ISO   ], $@)
endif

simd: $(BUILD_DIR)/os.bin
	@total=$$(objdump -d $(BUILD_DIR)/os.bin 2>/dev/null | grep -E '\b(xmm|ymm|zmm)[0-9]+' | wc -l); \
	printf "\033[32mTotal SIMD instructions generated:\033[0m \033[1;33m%5d\033[0m\n\n" "$$total"; \
	objdump -d $(BUILD_DIR)/os.bin 2>/dev/null | grep -E '\b(xmm|ymm|zmm)[0-9]+' | awk -F'\t' '{print $$3}' | awk '{print $$1}' | sort | uniq -c | sort -nr | head -n 50 | awk '{printf "  \033[33m%-15s\033[0m : %5d times\n", $$2, $$1}'

filesimd:
	@if [ -z "$(INST)" ]; then \
		printf "\033[31mError:\033[0m Specify INST=<name> (e.g. make filesimd INST=vmovups)\n"; \
		exit 1; \
	fi
	@set -eu; \
	inspect_dir="$(BUILD_DIR)/filesimd"; \
	tmp=$$(mktemp); \
	trap 'rm -f "$$tmp"' EXIT; \
	mkdir -p "$$inspect_dir"; \
	printf "\033[32mPreparing inspection objects:\033[0m \033[1;33m%s\033[0m\n" "$(INST)"; \
	$(MAKE) --no-print-directory BUILD_DIR="$$inspect_dir" \
		COMMON_FLAGS="$(COMMON_FLAGS) -g -fno-lto" \
		$(patsubst %.asm,$(BUILD_DIR)/filesimd/%.o,$(ASM_SRCS)) \
		$(patsubst %.c,$(BUILD_DIR)/filesimd/%.o,$(C_SRCS)) \
		$(patsubst %.cpp,$(BUILD_DIR)/filesimd/%.o,$(C++_SRCS)) \
		$(patsubst %.c,$(BUILD_DIR)/filesimd/%.o,$(BEARSSL_SOURCES)); \
	printf "\n\033[32mRanking source files by SIMD instruction:\033[0m \033[1;33m%s\033[0m\n\n" "$(INST)"; \
	find "$$inspect_dir" -type f -name '*.o' | while IFS= read -r obj; do \
		count=$$(objdump -d --no-show-raw-insn "$$obj" 2>/dev/null | \
			awk -v inst="$(INST)" ' \
				/^[[:space:]]*[[:xdigit:]]+:/ { \
					line=$$0; \
					sub(/^[[:space:]]*[[:xdigit:]]+:[[:space:]]*/, "", line); \
					split(line, fields, /[[:space:]]+/); \
					if (fields[1] == inst) count++; \
				} \
				END { print count+0 }'); \
		if [ "$$count" -gt 0 ]; then \
			src=$${obj#"$$inspect_dir"/}; \
			src=$${src%.o}; \
			for ext in cpp c asm; do \
				if [ -f "$$src.$$ext" ]; then src="$$src.$$ext"; break; fi; \
			done; \
			printf "%s %s\n" "$$count" "$$src" >> "$$tmp"; \
		fi; \
	done; \
	if [ -s "$$tmp" ]; then \
		sort -k1,1nr "$$tmp" | \
		awk '{printf "  \033[36m%-55s\033[0m : \033[1;33m%5d\033[0m times\n", $$2, $$1}'; \
	else \
		printf "\033[31mNo matching instructions found.\033[0m\n"; \
	fi

clean:
	$(Q)rm -rf $(BUILD_DIR) os.bin os.iso disk.img iso kernel.profdata kernel.afdo perf.data
	$(Q)cargo clean --manifest-path rust/kernel_heap/Cargo.toml 2>/dev/null || true
ifeq ($(V),1)
else
	@printf "\033[1;31m  [CLEAN] \033[0m\033[37mAll build artifacts purged successfully.\033[0m\n"
endif
